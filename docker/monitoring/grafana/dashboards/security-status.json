{
  "dashboard": {
    "title": "Security Status",
    "uid": "security-status",
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5m",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Last Scan Timestamp",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "security_scan_last_timestamp_seconds",
            "legendFormat": "Last Scan",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": { "unit": "dateTimeAsIso" }
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Scan Cadence (hours)",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
        "targets": [
          {
            "expr": "security_scan_interval_seconds / 3600",
            "legendFormat": "Interval (h)",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "h",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 24 },
                { "color": "red", "value": 72 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Scans Completed (24h)",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
        "targets": [
          {
            "expr": "increase(security_scans_total[24h])",
            "legendFormat": "Scans",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Critical Vulnerabilities",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "security_vulnerabilities_total{severity=\"critical\"}",
            "legendFormat": "Critical",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "High Vulnerabilities",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
        "targets": [
          {
            "expr": "security_vulnerabilities_total{severity=\"high\"}",
            "legendFormat": "High",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "type": "stat",
        "title": "Medium Vulnerabilities",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "security_vulnerabilities_total{severity=\"medium\"}",
            "legendFormat": "Medium",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "orange", "value": 10 }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "type": "stat",
        "title": "Low Vulnerabilities",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
        "targets": [
          {
            "expr": "security_vulnerabilities_total{severity=\"low\"}",
            "legendFormat": "Low",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 20 }
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "type": "graph",
        "title": "Vulnerability Trend by Severity",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "security_vulnerabilities_total{severity=\"critical\"}",
            "legendFormat": "critical",
            "refId": "A"
          },
          {
            "expr": "security_vulnerabilities_total{severity=\"high\"}",
            "legendFormat": "high",
            "refId": "B"
          },
          {
            "expr": "security_vulnerabilities_total{severity=\"medium\"}",
            "legendFormat": "medium",
            "refId": "C"
          },
          {
            "expr": "security_vulnerabilities_total{severity=\"low\"}",
            "legendFormat": "low",
            "refId": "D"
          }
        ],
        "yaxes": [
          { "label": "count", "show": true },
          { "show": false }
        ]
      },
      {
        "id": 9,
        "type": "graph",
        "title": "PII Detections Rate",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(security_pii_detections_total[5m])",
            "legendFormat": "{{type}} detections/s",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "detections/s", "show": true },
          { "show": false }
        ]
      },
      {
        "id": 10,
        "type": "graph",
        "title": "Guardrail Violations Rate",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "rate(security_guardrail_violations_total[5m])",
            "legendFormat": "{{policy}} violations/s",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "label": "violations/s", "show": true },
          { "show": false }
        ]
      }
    ]
  }
}
