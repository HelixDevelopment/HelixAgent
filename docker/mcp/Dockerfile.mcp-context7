# syntax=docker/dockerfile:1
# Per-submodule Dockerfile for context7-mcp (BUGFIXES Issue #54).
#
# pnpm monorepo with packages/{cli,mcp}. The mcp package builds to
# packages/mcp/dist/index.js and exposes `bin: { context7-mcp:
# dist/index.js }`. Default upstream start uses `--transport http`;
# we omit the flag so it falls back to stdio (the MCP default).

FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
# HXC-234: pnpm is PINNED, never `@latest`. An unpinned toolchain makes the
# image non-reproducible — its content changes with no diff on our side. That
# is exactly how this build broke: `pnpm@latest` floated up to 11.20.0, whose
# default turns ERR_PNPM_IGNORED_BUILDS into a hard install failure instead of
# a warning, and neither this upstream submodule nor anything we own runs
# `pnpm approve-builds`. 10.34.5 is the latest maintained 10.x, reads this
# repo's lockfileVersion 9.0, and predates that default change.
# Deliberately NOT an allow-list: enumerating @google/genai, protobufjs here
# would hardcode third-party dependency names we do not control into our
# Dockerfile, and silently re-break whenever upstream changes deps.
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate

COPY . .

# HXC-234: the build context is the checked-out submodule working tree, which
# on a developer host carries an untracked `node_modules/` from a prior host
# install (HXC-222 untracked them from git, but they remain on disk). `COPY . .`
# drags those host-built, possibly wrong-arch modules into the image; pnpm then
# detects a modules dir it did not create and aborts with
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY because it cannot prompt. Delete
# them explicitly rather than muting the prompt via CI=true: the stale host
# artifact is the actual defect, and removing it is deterministic across pnpm
# versions instead of depending on pnpm's CI-detection semantics.
RUN find . -name node_modules -type d -prune -exec rm -rf {} + && \
    pnpm install --frozen-lockfile=false --no-strict-peer-dependencies && \
    pnpm -r run build

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends socat netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app /app

EXPOSE 9000

# socat wraps stdio→TCP. NDJSON requires raw pipes, never pty.
# Note: context7-mcp's default --transport is http; omitting the flag
# uses stdio (MCP default).
RUN echo '#!/bin/sh' > /entrypoint.sh && \
    echo 'set -e' >> /entrypoint.sh && \
    echo 'echo "Starting context7-mcp (stdio→TCP wrapped)"' >> /entrypoint.sh && \
    echo 'echo "Listening on TCP port 9000..."' >> /entrypoint.sh && \
    echo 'exec socat TCP-LISTEN:9000,reuseaddr,fork SYSTEM:"node /app/packages/mcp/dist/index.js"' \
        >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]
