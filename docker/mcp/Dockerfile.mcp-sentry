# syntax=docker/dockerfile:1
# Per-submodule Dockerfile for sentry-mcp (BUGFIXES Issue #54).
#
# turbo monorepo. The standalone stdio server lives at
# packages/mcp-server with `bin: { sentry-mcp: dist/index.js }`.
# (mcp-cloudflare is a separate Cloudflare Workers variant; we use
# mcp-server for our Node-based stdio orchestrator.)

FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY . .

# Build via turbo (the workspace's chosen task runner). Filter to
# the mcp-server package and its transitive deps.
RUN pnpm install --frozen-lockfile=false --no-strict-peer-dependencies && \
    pnpm exec turbo build --filter=@sentry/mcp-server...

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends socat netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app /app

EXPOSE 9000

# socat wraps stdio→TCP. NDJSON requires raw pipes, never pty.
RUN echo '#!/bin/sh' > /entrypoint.sh && \
    echo 'set -e' >> /entrypoint.sh && \
    echo 'echo "Starting sentry-mcp (stdio→TCP wrapped)"' >> /entrypoint.sh && \
    echo 'echo "Listening on TCP port 9000..."' >> /entrypoint.sh && \
    echo 'exec socat TCP-LISTEN:9000,reuseaddr,fork SYSTEM:"node /app/packages/mcp-server/dist/index.js"' \
        >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]
