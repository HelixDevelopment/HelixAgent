# .env.scale.example — copy to .env.scale (or merge into containers/.env)
# and tune per environment. Every container resource in docker-compose.yml
# is driven by these variables; defaults in the compose file are
# DEV-tier, the values below are PRODUCTION-tier (matches
# docker-compose.scale.yml). Layer .env files with:
#
#   docker compose --env-file containers/.env --env-file .env.scale up -d
#
# Per-service rationale: docs/development/container-resource-policy.md.

# ============================================================
# TIER: TINY  (caches / dashboards / mocks)
# ============================================================
REDIS_MEM_LIMIT=2G
REDIS_MEM_RESERVE=512M
REDIS_CPU_LIMIT=1.00
REDIS_CPU_RESERVE=0.25

GRAFANA_MEM_LIMIT=2G
GRAFANA_MEM_RESERVE=512M
GRAFANA_CPU_LIMIT=1.00
GRAFANA_CPU_RESERVE=0.25

MOCK_LLM_MEM_LIMIT=2G
MOCK_LLM_MEM_RESERVE=512M
MOCK_LLM_CPU_LIMIT=1.00
MOCK_LLM_CPU_RESERVE=0.25

# ============================================================
# TIER: SMALL  (Python framework servers / metrics)
# ============================================================
PROMETHEUS_MEM_LIMIT=4G
PROMETHEUS_MEM_RESERVE=1G
PROMETHEUS_CPU_LIMIT=2.00
PROMETHEUS_CPU_RESERVE=0.50

LANGCHAIN_SERVER_MEM_LIMIT=4G
LANGCHAIN_SERVER_MEM_RESERVE=1G
LANGCHAIN_SERVER_CPU_LIMIT=2.00
LANGCHAIN_SERVER_CPU_RESERVE=0.50

LLAMAINDEX_SERVER_MEM_LIMIT=4G
LLAMAINDEX_SERVER_MEM_RESERVE=1G
LLAMAINDEX_SERVER_CPU_LIMIT=2.00
LLAMAINDEX_SERVER_CPU_RESERVE=0.50

GUIDANCE_SERVER_MEM_LIMIT=4G
GUIDANCE_SERVER_MEM_RESERVE=1G
GUIDANCE_SERVER_CPU_LIMIT=2.00
GUIDANCE_SERVER_CPU_RESERVE=0.50

LMQL_SERVER_MEM_LIMIT=4G
LMQL_SERVER_MEM_RESERVE=1G
LMQL_SERVER_CPU_LIMIT=2.00
LMQL_SERVER_CPU_RESERVE=0.50

# ============================================================
# TIER: MEDIUM  (databases / gateway / LLM-heavy services)
# ============================================================
POSTGRES_MEM_LIMIT=8G
POSTGRES_MEM_RESERVE=2G
POSTGRES_CPU_LIMIT=4.00
POSTGRES_CPU_RESERVE=1.00

CHROMADB_MEM_LIMIT=8G
CHROMADB_MEM_RESERVE=2G
CHROMADB_CPU_LIMIT=4.00
CHROMADB_CPU_RESERVE=1.00

MEMGRAPH_MEM_LIMIT=8G
MEMGRAPH_MEM_RESERVE=2G
MEMGRAPH_CPU_LIMIT=4.00
MEMGRAPH_CPU_RESERVE=1.00

NEO4J_MEM_LIMIT=8G
NEO4J_MEM_RESERVE=2G
NEO4J_CPU_LIMIT=4.00
NEO4J_CPU_RESERVE=1.00

COGNEE_MEM_LIMIT=8G
COGNEE_MEM_RESERVE=2G
COGNEE_CPU_LIMIT=4.00
COGNEE_CPU_RESERVE=1.00

HELIXAGENT_MEM_LIMIT=8G
HELIXAGENT_MEM_RESERVE=2G
HELIXAGENT_CPU_LIMIT=4.00
HELIXAGENT_CPU_RESERVE=1.00

SGLANG_MEM_LIMIT=8G
SGLANG_MEM_RESERVE=2G
SGLANG_CPU_LIMIT=4.00
SGLANG_CPU_RESERVE=1.00

# ============================================================
# TIER: XL  (local LLM serving — large weights in RAM)
# ============================================================
OLLAMA_MEM_LIMIT=24G
OLLAMA_MEM_RESERVE=8G
OLLAMA_CPU_LIMIT=8.00
OLLAMA_CPU_RESERVE=2.00
