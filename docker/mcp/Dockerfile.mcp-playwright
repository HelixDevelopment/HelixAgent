# syntax=docker/dockerfile:1
# Per-submodule Dockerfile for playwright-mcp (BUGFIXES Issue #54).
#
# Mirrors upstream's multi-stage build (browser image with chromium
# pre-installed) plus our socat wrapper for stdio→TCP at port 9000.
# CRITICAL: uses raw pipes (NOT pty) — pty mode corrupts MCP NDJSON
# framing.

ARG PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

FROM node:22-bookworm-slim AS base
ARG PLAYWRIGHT_BROWSERS_PATH
ENV PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH}
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends socat netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# LAYOUT: the pinned submodule (microsoft/playwright-mcp @ v0.0.77) is a FLAT
# repo — cli.js, index.js and package.json sit at the repo root and there is NO
# packages/ directory. An earlier revision bind-mounted and COPYd
# packages/playwright-mcp/{package.json,cli.js}, a MONOREPO layout this version
# does not have, so every build died with:
#   resolving mountpoints ... sanitizing bind subdirectory
#   ".../packages/playwright-mcp/package.json": no such file or directory
# and helixagent retried it on every start. Verified 2026-07-28 against the
# checked-out tree (`ls` shows no packages/, package.json + cli.js at root).
RUN --mount=type=cache,target=/root/.npm,sharing=locked,id=npm-cache \
    --mount=type=bind,source=package.json,target=package.json \
    --mount=type=bind,source=package-lock.json,target=package-lock.json \
  npm ci --omit=dev && \
  npx -y playwright-core install-deps chromium

FROM base AS browser
RUN npx -y playwright-core install --no-shell chromium

FROM base
ARG PLAYWRIGHT_BROWSERS_PATH
ARG USERNAME=node
ENV NODE_ENV=production
ENV PLAYWRIGHT_MCP_OUTPUT_DIR=/tmp/playwright-output

RUN chown -R ${USERNAME}:${USERNAME} node_modules
COPY --from=browser --chown=${USERNAME}:${USERNAME} ${PLAYWRIGHT_BROWSERS_PATH} ${PLAYWRIGHT_BROWSERS_PATH}
# Flat layout (see the LAYOUT note above): cli.js and package.json are at the
# repo root in v0.0.77, NOT under packages/playwright-mcp/.
COPY --chown=${USERNAME}:${USERNAME} cli.js package.json ./

# Entrypoint as root (need to write /entrypoint.sh) then drop privs.
RUN echo '#!/bin/sh' > /entrypoint.sh && \
    echo 'set -e' >> /entrypoint.sh && \
    echo 'echo "Starting playwright-mcp (stdio→TCP wrapped)"' >> /entrypoint.sh && \
    echo 'echo "Listening on TCP port 9000..."' >> /entrypoint.sh && \
    echo 'exec socat TCP-LISTEN:9000,reuseaddr,fork SYSTEM:"node /app/cli.js --headless --browser chromium --no-sandbox"' >> /entrypoint.sh && \
    chmod +x /entrypoint.sh && \
    chown ${USERNAME}:${USERNAME} /entrypoint.sh

USER ${USERNAME}
EXPOSE 9000

CMD ["/entrypoint.sh"]
